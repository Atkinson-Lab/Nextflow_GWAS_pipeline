/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Module configuration for ancestry-aware GWAS pipeline
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    // =====================
    // QC MODULES
    // =====================
    withName: 'PLINK2_QC' {
        ext.args = { [
            "--maf ${params.maf_threshold}",
            "--hwe ${params.hwe_threshold}",
            "--geno ${params.geno_missing}",
            "--mind ${params.mind_missing}"
        ].join(' ') }
        publishDir = [
            path: { "${params.outdir}/qc" },
            mode: params.publish_dir_mode
        ]
    }

    // =====================
    // ANCESTRY MODULES
    // =====================
    withName: 'GRAF_ANCESTRY' {
        publishDir = [
            path: { "${params.outdir}/ancestry/graf" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'ANCESTRY_STRATIFY' {
        publishDir = [
            path: { "${params.outdir}/ancestry/stratified" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'RFMIX_LOCAL_ANCESTRY' {
        publishDir = [
            path: { "${params.outdir}/ancestry/local_ancestry" },
            mode: params.publish_dir_mode
        ]
    }

    // =====================
    // GWAS MODULES
    // =====================
    withName: 'REGENIE_STEP1' {
        ext.args = '--loocv --bsize 1000 --lowmem'
        publishDir = [
            path: { "${params.outdir}/gwas/${meta.ancestry}/regenie/step1" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'REGENIE_STEP2' {
        ext.args = '--firth --approx --firth-se --minMAC 20'
        publishDir = [
            path: { "${params.outdir}/gwas/${meta.ancestry}/${meta.trait}/regenie" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'SAIGE_STEP1' {
        publishDir = [
            path: { "${params.outdir}/gwas/${meta.ancestry}/saige/step1" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'SAIGE_STEP2' {
        publishDir = [
            path: { "${params.outdir}/gwas/${meta.ancestry}/${meta.trait}/saige" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'BOLT_LMM' {
        publishDir = [
            path: { "${params.outdir}/gwas/${meta.ancestry}/${meta.trait}/bolt" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'PLINK2_GWAS' {
        publishDir = [
            path: { "${params.outdir}/gwas/${meta.ancestry}/${meta.trait}/plink2" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'GWAS_FILTER' {
        publishDir = [
            path: { "${params.outdir}/gwas/${meta.ancestry}/${meta.trait}/filtered" },
            mode: params.publish_dir_mode
        ]
    }

    // =====================
    // META-ANALYSIS MODULES
    // =====================
    withName: 'MR_MEGA' {
        publishDir = [
            path: { "${params.outdir}/meta_analysis/${meta.trait}/mr_mega" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'MR_MEGA_ENV' {
        publishDir = [
            path: { "${params.outdir}/meta_analysis/${meta.trait}/mr_mega_env" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'METAL' {
        publishDir = [
            path: { "${params.outdir}/meta_analysis/${meta.trait}/metal" },
            mode: params.publish_dir_mode
        ]
    }

    // =====================
    // FINE-MAPPING MODULES
    // =====================
    withName: 'POLYFUN_MUNGING' {
        publishDir = [
            path: { "${params.outdir}/fine_mapping/${meta.ancestry}/${meta.trait}/polyfun/munged" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'POLYFUN_SUSIE' {
        publishDir = [
            path: { "${params.outdir}/fine_mapping/${meta.ancestry}/${meta.trait}/polyfun_susie" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'SUSIE' {
        publishDir = [
            path: { "${params.outdir}/fine_mapping/${meta.ancestry}/${meta.trait}/susie" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'MG_FLASH_FM' {
        publishDir = [
            path: { "${params.outdir}/fine_mapping/multi_ancestry/${meta.trait}/mg_flash_fm" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'SUSIE_ME' {
        publishDir = [
            path: { "${params.outdir}/fine_mapping/multi_ancestry/${meta.trait}/susie_me" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'CREDIBLE_SETS' {
        publishDir = [
            path: { "${params.outdir}/fine_mapping/${meta.ancestry}/${meta.trait}/credible_sets" },
            mode: params.publish_dir_mode
        ]
    }

    // =====================
    // COLOCALIZATION MODULES
    // =====================
    withName: 'COLOC' {
        publishDir = [
            path: { "${params.outdir}/colocalization/${meta.trait}/coloc" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'ECAVIAR' {
        publishDir = [
            path: { "${params.outdir}/colocalization/${meta.trait}/ecaviar" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'FASTENLOC' {
        publishDir = [
            path: { "${params.outdir}/colocalization/${meta.trait}/fastenloc" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'PREPARE_QTL_DATA' {
        publishDir = [
            path: { "${params.outdir}/colocalization/qtl_data" },
            mode: params.publish_dir_mode
        ]
    }

    // =====================
    // PRS MODULES
    // =====================
    withName: 'PRS_CSX' {
        publishDir = [
            path: { "${params.outdir}/prs/${meta.trait}/prs_csx" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'PRS_CS' {
        publishDir = [
            path: { "${params.outdir}/prs/${meta.trait}/${meta.ancestry}/prs_cs" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'GAUDI' {
        publishDir = [
            path: { "${params.outdir}/prs/${meta.trait}/gaudi" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'LDPRED2' {
        publishDir = [
            path: { "${params.outdir}/prs/${meta.trait}/${meta.ancestry}/ldpred2" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'PRS_VALIDATION' {
        publishDir = [
            path: { "${params.outdir}/prs/${meta.trait}/validation" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'PRS_COMPARISON' {
        publishDir = [
            path: { "${params.outdir}/prs/${meta.trait}/comparison" },
            mode: params.publish_dir_mode
        ]
    }

    // =====================
    // HERITABILITY MODULES
    // =====================
    withName: 'LDSC_MUNGE' {
        publishDir = [
            path: { "${params.outdir}/heritability/${meta.ancestry}/${meta.trait}/ldsc/munged" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'LDSC_H2' {
        publishDir = [
            path: { "${params.outdir}/heritability/${meta.ancestry}/${meta.trait}/ldsc" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'LDSC_RG' {
        publishDir = [
            path: { "${params.outdir}/heritability/genetic_correlation" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'GCTA_GREML' {
        publishDir = [
            path: { "${params.outdir}/heritability/${meta.ancestry}/${meta.trait}/gcta" },
            mode: params.publish_dir_mode
        ]
    }

    // =====================
    // FUNCTIONAL ANNOTATION MODULES
    // =====================
    withName: 'MAGMA_ANNOTATE' {
        publishDir = [
            path: { "${params.outdir}/functional/${meta.trait}/magma/annotate" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'MAGMA_GENE' {
        publishDir = [
            path: { "${params.outdir}/functional/${meta.trait}/magma/gene" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'MAGMA_GENESET' {
        publishDir = [
            path: { "${params.outdir}/functional/${meta.trait}/magma/geneset" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'FUMA_ANALYSIS' {
        publishDir = [
            path: { "${params.outdir}/functional/${meta.trait}/fuma" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'LAVA' {
        publishDir = [
            path: { "${params.outdir}/functional/${meta.trait}/lava" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'FLAMES' {
        publishDir = [
            path: { "${params.outdir}/functional/${meta.trait}/flames" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'CELL_TYPE_ENRICHMENT' {
        publishDir = [
            path: { "${params.outdir}/functional/${meta.trait}/cell_type" },
            mode: params.publish_dir_mode
        ]
    }

    // =====================
    // VISUALIZATION MODULES
    // =====================
    withName: 'MANHATTAN_PLOT' {
        publishDir = [
            path: { "${params.outdir}/plots/${meta.trait}/manhattan" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'QQ_PLOT' {
        publishDir = [
            path: { "${params.outdir}/plots/${meta.trait}/qq" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'REGIONAL_PLOT' {
        publishDir = [
            path: { "${params.outdir}/plots/${meta.trait}/regional" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'MIAMI_PLOT' {
        publishDir = [
            path: { "${params.outdir}/plots/${meta.trait}/miami" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'FOREST_PLOT' {
        publishDir = [
            path: { "${params.outdir}/plots/${meta.trait}/forest" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'PRS_PLOT' {
        publishDir = [
            path: { "${params.outdir}/plots/${meta.trait}/prs" },
            mode: params.publish_dir_mode
        ]
    }

    // =====================
    // REPORT MODULES
    // =====================
    withName: 'MULTIQC' {
        ext.args = '--interactive'
        publishDir = [
            path: { "${params.outdir}/reports" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'CUSTOM_REPORT' {
        publishDir = [
            path: { "${params.outdir}/reports" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'SOFTWARE_VERSIONS' {
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: params.publish_dir_mode
        ]
    }
}
