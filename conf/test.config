/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Test configuration for ancestry-aware GWAS pipeline
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Minimal test dataset configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset for pipeline functionality'

    // Limit resources
    max_cpus   = 2
    max_memory = '6.GB'
    max_time   = '2.h'

    // Test data (would point to actual test data)
    input          = 'https://raw.githubusercontent.com/your-org/test-datasets/main/samplesheet.csv'
    phenotype_file = 'https://raw.githubusercontent.com/your-org/test-datasets/main/phenotypes.txt'
    phenotype_cols = 'trait1'
    outdir         = './results_test'

    // Minimal analysis
    min_ancestry_n   = 10
    meta_analysis    = false
    fine_mapping     = false
    prs_analysis     = false
    heritability     = false
    colocalization   = false
    functional_annotation = false
}
