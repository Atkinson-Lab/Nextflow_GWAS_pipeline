/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    SLURM cluster configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    executor = 'slurm'
    queue = 'normal'
    clusterOptions = '--account=your_account'

    // Adjust based on your cluster
    withLabel:process_single {
        cpus   = 1
        memory = 4.GB
        time   = 1.h
    }
    withLabel:process_low {
        cpus   = 4
        memory = 16.GB
        time   = 4.h
    }
    withLabel:process_medium {
        cpus   = 8
        memory = 32.GB
        time   = 8.h
    }
    withLabel:process_high {
        cpus   = 16
        memory = 64.GB
        time   = 24.h
    }
    withLabel:process_high_memory {
        cpus   = 8
        memory = 200.GB
        time   = 24.h
        queue  = 'bigmem'
    }
}

executor {
    queueSize = 100
    submitRateLimit = '10 sec'
}

// Singularity settings for HPC
singularity {
    enabled = true
    autoMounts = true
    cacheDir = '/scratch/singularity_cache'
}
